# Add this block to ~/infrastructure/Caddyfile on the server.
# Replace APP_NAME and yourdomain.com with real values.

APP_NAME.yourdomain.com {
	root * /srv/APP_NAME

	handle /api/* {
		reverse_proxy APP_NAME-backend:3001 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		encode gzip zstd
		try_files {path} {path}/ /index.html
		file_server

		header {
			X-Frame-Options "SAMEORIGIN"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			-Server
		}
	}

	@static {
		path *.js *.css *.png *.jpg *.jpeg *.gif *.svg *.ico *.woff *.woff2 *.ttf *.eot
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	@html {
		path *.html /
	}
	header @html Cache-Control "no-cache, no-store, must-revalidate"
}
